rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /clientes/{docId} {
      allow read, write: if signedIn();
    }

    match /ordensServico/{docId} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /garantias/{docId} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /produtos/{docId} {
      allow read: if signedIn() || resource.data.ativo == true;
      allow write: if signedIn();
    }

    match /fornecedores/{docId} {
      allow read, write: if signedIn();
    }

    match /comprasFornecedores/{docId} {
      allow read, write: if signedIn();
    }

    match /pedidos/{docId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if signedIn();
    }

    match /entregas/{docId} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /treinamentos/{docId} {
      allow read: if signedIn() || resource.data.ativo == true;
      allow write: if signedIn();
    }

    match /progressoTreinamentos/{docId} {
      allow read, write: if signedIn();
    }

    match /movimentacoesEstoque/{docId} {
      allow read, write: if signedIn();
    }

    match /financeiro/{docId} {
      allow read, write: if signedIn();
    }

    match /documentos/{docId} {
      allow read, write: if signedIn();
    }

    match /notasOficiais/{docId} {
      allow read, write: if signedIn();
    }

    match /orcamentos/{docId} {
      allow read, write: if signedIn();
    }

    match /configuracoes/{docId} {
      allow read, write: if signedIn();
    }
  }
}
